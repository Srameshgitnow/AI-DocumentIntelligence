# Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_doc_intelligence
DB_USER=postgres
DB_PASSWORD=postgres

# OpenAI (optional if using Hugging Face fallback for embeddings)
OPENAI_API_KEY=

# Anthropic / Claude
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: use Hugging Face embeddings instead of OpenAI embeddings
HUGGINGFACE_API_KEY=

# Note: keep secrets out of git history. Rotate any leaked keys and purge them from the repo history if needed.

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# LLM Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
